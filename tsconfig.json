{
  "compilerOptions": {
    "incremental": true,
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "composite": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@/app/*": ["src/app/*"],
      "@/components/*": ["src/components/*"],
      "@/lib/*": ["src/lib/*"],
      "@/layouts/*": ["src/layouts/*"],
      "@/styles/*": ["src/styles/*"],
      "@/types/*": ["src/types/*"],
      "@/data/*": ["data/*"],
      "@/public/*": ["public/*"],
      "@/.source": [".source"],
      "@/.source/*": [".source/*"],
      "@/*": ["src/*"],
      "pliny/*": ["node_modules/pliny/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
    "strictNullChecks": true
  },
  "include": [
    "**/*.mjs",
    ".next/types/**/*.ts",
    ".source",
    ".source/**/*",
    "data/**/*.js",
    "data/**/*.ts",
    "next-env.d.ts",
    "scripts/**/*.mjs",
    "scripts/**/*.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "build/types/**/*.ts",
    "vitest.config.ts",
    "prisma/**/*.ts"
  ],
  "exclude": ["node_modules", "eslint.config.mjs", ".next"]
}
