# ============================================================================
# 环境配置示例 - 五道口AI创业羽毛球俱乐部
# 复制此文件为 .env.local 并填入实际配置
# ============================================================================

# ------------ 应用配置 ------------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=五道口AI创业羽毛球俱乐部

# ------------ 数据库（PostgreSQL）------------
# 本地开发示例
DATABASE_URL="postgresql://username:password@localhost:5432/wdk_badminton?schema=public"

# 阿里云 RDS 示例（生产环境）
# DATABASE_URL="postgresql://username:password@rm-xxxxx.pg.rds.aliyuncs.com:5432/wdk_badminton?schema=public"

# ------------ JWT 认证 ------------
# 生成方式: openssl rand -base64 32
JWT_SECRET=your_very_long_random_secret_key_change_me_in_production_at_least_32_characters

# ------------ 微信登录（可选，Phase 2 再配置）------------
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# ------------ 短信服务（阿里云，可选）------------
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=五道口羽毛球
ALIYUN_SMS_TEMPLATE_CODE=

# ------------ 对象存储（阿里云 OSS，可选）------------
OSS_REGION=oss-cn-beijing
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=wdk-badminton
NEXT_PUBLIC_OSS_CDN_URL=

# ------------ Redis（可选，用于 Session/缓存）------------
REDIS_URL=

# ------------ 开发工具 ------------
# 如果使用 Prisma Studio
# DATABASE_URL 会自动使用

# ------------ 第三方服务（可选）------------
# Sentry（错误追踪）
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=

# Google Analytics
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
